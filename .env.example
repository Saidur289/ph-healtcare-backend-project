# Copy to .env and fill in. Placeholders only: never put real values in this file.
# Required values are checked at startup (src/app/config/env.ts); production refuses weak secrets.
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:5000

# secrets: 32+ random characters each, all different (openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BETTER_AUTH_SESSION_TOKEN_EXPIRES_IN=1d
BETTER_AUTH_SESSION_TOKEN_UPDATE_AGE=1d
# AES-256 key for encrypted columns, 32 bytes base64 (openssl rand -base64 32). Back it up!
DATA_ENCRYPTION_KEY=change-me

EMAIL_SENDER_USER_SMTP_HOST=smtp.example.com
EMAIL_SENDER_USER_SMTP_PORT=465
EMAIL_SENDER_USER_USER=change-me
EMAIL_SENDER_USER_PASS=change-me
EMAIL_SENDER_USER_SMTP_FROM="PH Healthcare <no-reply@example.com>"

GOOGLE_CLIENT_ID=change-me
GOOGLE_SECRET_KEY=change-me

CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# sk_test_... everywhere except production (sk_live_...)
STRIPE_SECRET_KEY=sk_test_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me
# ALLOW_STRIPE_TEST_IN_PRODUCTION=true   # staging only

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_NAME=Super Admin

# video calls (Daily.co)
DAILY_API_KEY=change-me

# optional
# CLINIC_TIME_ZONE=Asia/Dhaka
# TRUST_PROXY=1                 # behind one reverse proxy / load balancer
# LOG_LEVEL=info
# SENTRY_DSN=                   # error tracking (off when empty)
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
