# Environment for `npm test` ONLY. Every value here is fake and safe to commit.
# The database is a throwaway Postgres started by tests/globalSetup.ts (no Docker).
NODE_ENV=test
PORT=5099
# replaced at run time by the throwaway database from tests/globalSetup.ts
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ph_test
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:5099
BETTER_AUTH_SECRET=test-better-auth-secret-0123456789abcdef
ACCESS_TOKEN_SECRET=test-access-token-secret-0123456789abcdef
REFRESH_TOKEN_SECRET=test-refresh-token-secret-0123456789abcdef
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BETTER_AUTH_SESSION_TOKEN_EXPIRES_IN=1d
BETTER_AUTH_SESSION_TOKEN_UPDATE_AGE=1d
EMAIL_SENDER_USER_PASS=not-used
EMAIL_SENDER_USER_USER=not-used
EMAIL_SENDER_USER_SMTP_HOST=localhost
EMAIL_SENDER_USER_SMTP_PORT=2525
EMAIL_SENDER_USER_SMTP_FROM=tests@example.test
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_SECRET_KEY=test-google-secret
CLOUDINARY_CLOUD_NAME=test-cloud
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=test-cloudinary-secret
STRIPE_SECRET_KEY=sk_test_fake_key_for_automated_tests
STRIPE_WEBHOOK_SECRET=whsec_test_secret_for_automated_tests
SUPER_ADMIN_EMAIL=superadmin@example.test
SUPER_ADMIN_PASSWORD="SuperAdmin#Test2026"
SUPER_ADMIN_NAME=Test Super Admin
DATA_ENCRYPTION_KEY=dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHR0dHQ=
DAILY_API_KEY=test-daily-key
# test switches
RATE_LIMIT=off
INVOICE_DELIVERY=off
PRESCRIPTION_DELIVERY=off
LOG_LEVEL=silent
